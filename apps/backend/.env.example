BACKEND_HOST=0.0.0.0
API_GATEWAY_PORT=3000
DIARY_SERVICE_PORT=3001
SKIN_SERVICE_PORT=3002
PHOTO_SERVICE_PORT=3003
ENVIRONMENT_SERVICE_PORT=3004
INSIGHTS_SERVICE_PORT=3005
TREATMENT_SERVICE_PORT=3006

DIARY_SERVICE_URL=http://localhost:3001
SKIN_SERVICE_URL=http://localhost:3002
PHOTO_SERVICE_URL=http://localhost:3003
ENVIRONMENT_SERVICE_URL=http://localhost:3004
INSIGHTS_SERVICE_URL=http://localhost:3005
TREATMENT_SERVICE_URL=http://localhost:3006

# Expo Go / mobile development:
# Use your Mac's LAN IP, not localhost, when calling from a physical phone.
# Example: PUBLIC_API_BASE_URL=http://192.168.178.42:3000
PUBLIC_API_BASE_URL=
PUBLIC_API_PROTOCOL=http
CORS_ORIGINS=
JSON_BODY_LIMIT=25mb

# Supabase / Postgres:
# Prefer Supabase's Session Pooler connection string for local development if
# db.<project-ref>.supabase.co is not DNS-reachable on your machine/network.
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rash-photos

# Later integration points:
PHOTO_SERVICE_DATA_DIR=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_USER_AGENT=neurodermitis-tracker/0.1 (prototype)
WEATHER_PROVIDER_API_KEY=
POLLEN_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY=
