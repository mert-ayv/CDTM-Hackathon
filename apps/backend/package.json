{
  "name": "@cdtm-hackathon/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n gateway,diary,skin,photos,environment,insights,treatment -c cyan,green,magenta,blue,yellow,red,white \"npm run dev:gateway\" \"npm run dev:diary\" \"npm run dev:skin\" \"npm run dev:photos\" \"npm run dev:environment\" \"npm run dev:insights\" \"npm run dev:treatment\"",
    "dev:gateway": "tsx watch src/services/api-gateway/index.ts",
    "dev:diary": "tsx watch src/services/diary-service/index.ts",
    "dev:skin": "tsx watch src/services/skin-service/index.ts",
    "dev:photos": "tsx watch src/services/photo-service/index.ts",
    "dev:environment": "tsx watch src/services/environment-service/index.ts",
    "dev:insights": "tsx watch src/services/insights-service/index.ts",
    "dev:treatment": "tsx watch src/services/treatment-service/index.ts",
    "build": "tsc",
    "start": "node dist/services/api-gateway/index.js",
    "start:gateway": "node dist/services/api-gateway/index.js",
    "start:diary": "node dist/services/diary-service/index.js",
    "start:skin": "node dist/services/skin-service/index.js",
    "start:photos": "node dist/services/photo-service/index.js",
    "start:environment": "node dist/services/environment-service/index.js",
    "start:insights": "node dist/services/insights-service/index.js",
    "start:treatment": "node dist/services/treatment-service/index.js",
    "lan-ip": "node -e \"const os=require('os'); const ips=Object.values(os.networkInterfaces()).flat().filter(Boolean).filter((item)=>item.family==='IPv4'&&!item.internal).map((item)=>item.address); console.log(ips.join('\\n'))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
